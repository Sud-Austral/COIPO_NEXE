# Plantilla del .env de PRODUCCIÓN. El .env real lo crea el bootstrap del servidor y
# NUNCA se commitea (está en .gitignore).
#
# Todas las variables sin valor por defecto en backend/app/config.py están listadas
# aquí: si falta una en el .env del servidor, el contenedor arranca, falla el
# healthcheck y el `docker compose up` completo se cae con "dependency failed to
# start" (guía 8 §2).

# ── PostgreSQL 17 compartido (lo administra TI; este repo NO crea base ni rol) ──
DATABASE_HOST=172.31.2.40
DATABASE_PORT=5432
# El rol puede NO coincidir con el nombre del repo (asignación externa). La carpeta
# del servidor, en cambio, siempre es el nombre del repo: /opt/apps/coipo_nexe/
DATABASE_USER=<rol asignado por TI>
DATABASE_PASSWORD=<contraseña entregada por TI>
DATABASE_NAME=<base asignada por TI>

# ── El ÚNICO puerto publicado: el vhost de Nginx del servidor apunta acá ────────
# SIN valor de ejemplo a propósito: debe ser único en la VM. Si dos apps coinciden,
# el smoke test de una puede dar VERDE contra el /health de la otra (guía 8 §2).
# Comprobar antes de fijarlo:  sudo ss -tlnp | grep :<puerto>
APP_PORT=

# ── Nexe (AFF JSON) — la usa SOLO el collector; el backend nunca llama a Nexe ───
# El paso a producción consiste únicamente en cambiar esta URL (confirmado por Nexe).
NEXE_BASE_URL=https://staging.nexe.online/api/v1/monitor
# UUID entregado por Nexe (José Cartagenova, jcartagenova@heligrafics.net). Si el
# collector empieza a registrar ClaveRechazada (401), pedir la key vigente: el cursor
# de ingesta no se toca y la ingesta se reanuda sola al reponerla.
NEXE_API_KEY=<uuid entregado por Nexe>

# ── Ambiente ───────────────────────────────────────────────────────────────────
# En "production" el backend se niega a arrancar si la contraseña o el host siguen
# con los valores de desarrollo (backend/app/config.py::validar_para_produccion).
APP_ENV=production

# ── Ingesta (opcionales; los defaults viven en backend/app/config.py) ──────────
# Pasadas por corrida de cron: 1 = ~1 min de latencia, 2 = ~30 s. La cadencia afecta
# la latencia, nunca la completitud (el cursor por dataCtrTime no pierde nada).
# COLLECTOR_PASADAS_POR_MINUTO=1
# COLLECTOR_MAX_PAGINAS=20
# COLLECTOR_LOOKBACK_DIAS=14
# COLLECTOR_ARRANQUE_DIAS=14

# ── Solo desarrollo (docker-compose.dev.yml) ──────────────────────────────────
# BACKEND_PORT=8000
# POSTGRES_DEV_PORT=5432
