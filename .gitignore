# Secretos server-side: el .env real lo crea el bootstrap del servidor y NUNCA
# se commitea. Solo la plantilla viaja al repo.
.env
.env.*
!.env.example

# Descargas del extractor histórico (descargar_historico_nexe.py) — datos, no código
# Anclado con barra inicial: sin ella, git ignoraría CUALQUIER carpeta con este
# nombre a cualquier profundidad (guía 8 §8).
/datos_historicos/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node (el frontend tiene su propio .gitignore, esto cubre la raíz)
node_modules/

# reglas de COIPO_ERRORES (rutas absolutas, personales)
.claude/rules/errores-*.md
