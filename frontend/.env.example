# ── Server-side (proxy Express) — NUNCA commitear el .env real ──────────────
# Base de Nexe. Paso a producción = cambiar solo esta URL (CLAUDE.md §6).
NEXE_BASE_URL=https://staging.nexe.online/api/v1/monitor
# Key del correo de Nexe (pedir al equipo). SOLO de servidor: jamás en VITE_*.
NEXE_API_KEY=
PORT=3001

# ── Frontend (Vite) — sin secretos ───────────────────────────────────────────
VITE_API_BASE=/api/nexe

# ── Solo para el mock (server/mock.ts) ───────────────────────────────────────
# MOCK_PORT=3002
# MOCK_FAIL_RATE=0.1
# MOCK_LATENCY_MS=800
